# ==== rentalrdp.com — PRODUCTION ENV ====
# Salin file ini jadi .env lalu isi. Untuk orang awam: cukup jalankan install.bat
# Mode database ganda (otomatis):
#  - Kosongkan DATABASE_URL atau isi file:./data/rentalrdp-pg  -> mode INSTAN (PGlite, Postgres-compatible, tanpa install apa-apa). cocok untuk coba-coba / migrasi awam.
#  - Isi postgres://user:pass@host:5432/dbname                -> mode PRODUKSI (PostgreSQL beneran).

PORT=3000
APP_URL=http://localhost:3000
APP_NAME=Rental PC by Miriprian

# Contoh produksi (Docker Postgres):
#   DATABASE_URL=postgres://rentalrdp:PASS@db:5432/rentalrdp
#   POSTGRES_PASSWORD=PASS      (dipakai docker-compose utk bikin DB & JWT)
# Contoh produksi (Postgres eksternal):
#   DATABASE_URL=postgres://user:pass@localhost:5432/rentalrdp
# Mode instan (tanpa install DB) — untuk coba-coba / migrasi awam:
DATABASE_URL=file:./data/rentalrdp-pg
# POSTGRES_PASSWORD=changeme

# WAJIB diganti di produksi! Generate: bun run gen:secret
JWT_SECRET=ganti-ini-minimal-32-karakter-acak-produksi-1234567890
# Kunci enkripsi password RDP (32 bytes hex / 64 char). Generate otomatis saat setup.
APP_KEY=

# Admin pertama (bisa diubah nanti di dashboard)
SEED_ADMIN_USER=obake
SEED_ADMIN_PASS=obake
SEED_ADMIN_EMAIL=obake@rentalrdp.com

# Katalog: default KOSONG (hanya PC real dari agent). Set SEED_DEMO_PCS=true kalau mau PC demo saat seed.
SEED_DEMO_PCS=false

# Keamanan / rate limit
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_MAX=15
COOKIE_SECURE=false
# set true jika sudah HTTPS produksi
TRUST_PROXY=false
