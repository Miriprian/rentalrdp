{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "outDir": "dist",
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "agent/**/*", "scripts/**/*"]
}
