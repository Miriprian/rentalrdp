{
  "name": "rental-pc-by-miriprian",
  "version": "1.0.0",
  "description": "Rental PC by Miriprian — Platform sewa PC bare metal (fisik, bukan virtual) — Bun + Elysia + Drizzle + PostgreSQL",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "seed": "bun run src/db/seed.ts",
    "setup": "bun install && bun run src/db/migrate.ts && bun run src/db/seed.ts",
    "agent": "bun run agent/agent.ts",
    "agent:exe": "bun build --compile agent/agent-standalone.ts --outfile agent/windows-rentalrdp-agent.exe",
    "backup": "bun run scripts/backup.ts",
    "gen:secret": "bun run scripts/gen-secret.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/jwt": "^1.1.0",
    "@elysiajs/static": "^1.1.0",
    "drizzle-orm": "^0.36.4",
    "elysia": "^1.1.0",
    "pg": "^8.13.1",
    "@electric-sql/pglite": "^0.2.15",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3"
  }
}
